{
    "name": "el-schneider/statamic-ai-labels",
    "autoload": {
        "psr-4": {
            "ElSchneider\\StatamicAiLabels\\": "src"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "ElSchneider\\StatamicAiLabels\\Tests\\": "tests"
        }
    },
    "require": {
        "statamic/cms": "^6.0"
    },
    "require-dev": {
        "orchestra/testbench": "^11.0",
        "pestphp/pest": "^5.0",
        "pestphp/pest-plugin-laravel": "*",
        "laravel/pint": "*"
    },
    "config": {
        "allow-plugins": {
            "pixelfear/composer-dist-plugin": true,
            "pestphp/pest-plugin": true
        }
    },
    "extra": {
        "statamic": {
            "name": "Statamic Ai Labels",
            "description": "Statamic Ai Labels addon"
        },
        "laravel": {
            "providers": [
                "ElSchneider\\StatamicAiLabels\\ServiceProvider"
            ]
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
